# ════════════════════════════════════════════════════════════════
#  FinParty PCCh — Variables de entorno
#  Copiar este archivo como ".env" y completar los valores reales
# ════════════════════════════════════════════════════════════════

# ─── Base de datos PostgreSQL (Docker local) ──────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finparty
DB_USER=finparty_user
DB_PASSWORD=finparty_2026!

# ─── Correo IMAP (finanzas del partido) ──────────────────────
# Gmail: imap.gmail.com / Puerto 993 / SSL
# Outlook: outlook.office365.com / Puerto 993 / SSL
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=finanzas@pcch.cl
IMAP_PASSWORD=app_password_aqui   # Usar "Contraseña de aplicación" si Gmail
IMAP_FOLDER=INBOX                  # Carpeta a monitorear (INBOX, Finanzas, etc.)
IMAP_SINCE_DAYS=3                  # Revisar últimos N días en cada ejecución

# ─── Notificaciones (resumen diario) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=finanzas@pcch.cl
SMTP_PASSWORD=app_password_aqui
NOTIF_DESTINATARIOS=cristobal.morales@pcch.cl,alejandro.urquiza@pcch.cl

# ─── UF (actualización diaria) ───────────────────────────────
MINDICADOR_URL=https://mindicador.cl/api/uf

# ─── Pipeline ─────────────────────────────────────────────────
HORA_EJECUCION=07:00               # Hora diaria de ejecución (HH:MM)
CONFIDENCE_MINIMA=0.80             # Score mínimo para carga automática
ATTACHMENTS_DIR=./attachments      # Directorio local de respaldo de adjuntos
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# ─── RUT del partido (receptor en BHE/facturas) ───────────────
RUT_PARTIDO=71701800-1
NOMBRE_PARTIDO=Partido Comunista de Chile
