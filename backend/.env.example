# ════════════════════════════════════════════════════════════════
#  FinParty PCCh — Variables de entorno
#  Copiar este archivo como ".env" y completar los valores reales
# ════════════════════════════════════════════════════════════════

# ─── Base de datos PostgreSQL (Docker local) ──────────────────
DB_HOST=localhost
DB_PORT=5432
DB_NAME=finparty
DB_USER=finparty_user
DB_PASSWORD=CAMBIAR_clave_db_fuerte_y_unica   # NO usar el default en producción

# ─── Intranet / Seguridad (auth de funcionarios) ──────────────
# JWT_SECRET: secreto para firmar los tokens. OBLIGATORIO en producción.
# Generar uno aleatorio, p. ej.:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CAMBIAR_secreto_aleatorio_min_32_bytes
JWT_EXPIRE_MIN=60                  # Minutos de validez del token
LOGIN_MAX_INTENTOS=5              # Intentos fallidos antes de bloquear la cuenta
LOGIN_BLOQUEO_MIN=15             # Minutos de bloqueo tras superar los intentos
MAX_UPLOAD_MB=20                 # Tamaño máximo de archivos subidos (BHE/contratos)
# CORS_ORIGINS: dominios del frontend autorizados (coma-separados).
# En producción usar el dominio real; NO usar "*".
CORS_ORIGINS=http://localhost:5173,http://localhost:5191
RENDICION_DIR=./rendicion         # Carpeta donde se generan las rendiciones

# ─── Usuario administrador inicial (solo para seed_admin.py) ───
# Se usan UNA vez para crear el primer admin. La clave se guarda hasheada.
# Recomendado pasarlas en la línea de comando del seed, no dejarlas en .env.
ADMIN_USER=admin@pcch.cl
ADMIN_PASS=CAMBIAR_clave_admin_min_8_caracteres
ADMIN_NOMBRE=Administrador

# ─── Autoinscripción (registro de funcionarios/as) ────────────
# Solo se permite registrarse con correos de este dominio.
EMAIL_DOMAIN_PERMITIDO=pcchile.org
# URL pública del frontend (para el enlace de "definir contraseña" del correo).
FRONTEND_URL=https://tu-dominio-frontend
# Remitente de los correos (si vacío, usa SMTP_USER).
CORREO_REMITENTE=no-reply@pcchile.org
# Validez del enlace de definir/restablecer contraseña, en minutos (default 48 h).
TOKEN_PASSWORD_MIN=2880
# NOTA: el envío usa SMTP_HOST/SMTP_USER/SMTP_PASSWORD (arriba). Para enviar desde
# @pcchile.org: Proton Business SMTP submission, o un proveedor transaccional
# (SES/Postmark/SendGrid) con SPF+DKIM en el dominio pcchile.org.

# ─── Correo IMAP (finanzas del partido) ──────────────────────
# Gmail: imap.gmail.com / Puerto 993 / SSL
# Outlook: outlook.office365.com / Puerto 993 / SSL
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=finanzas@pcch.cl
IMAP_PASSWORD=app_password_aqui   # Usar "Contraseña de aplicación" si Gmail
IMAP_FOLDER=INBOX                  # Carpeta a monitorear (INBOX, Finanzas, etc.)
IMAP_SINCE_DAYS=3                  # Revisar últimos N días en cada ejecución

# ─── Notificaciones (resumen diario) ─────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=finanzas@pcch.cl
SMTP_PASSWORD=app_password_aqui
NOTIF_DESTINATARIOS=cristobal.morales@pcch.cl,alejandro.urquiza@pcch.cl

# ─── UF (actualización diaria) ───────────────────────────────
MINDICADOR_URL=https://mindicador.cl/api/uf

# ─── Pipeline ─────────────────────────────────────────────────
HORA_EJECUCION=07:00               # Hora diaria de ejecución (HH:MM)
CONFIDENCE_MINIMA=0.80             # Score mínimo para carga automática
ATTACHMENTS_DIR=./attachments      # Directorio local de respaldo de adjuntos
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR

# ─── RUT del partido (receptor en BHE/facturas) ───────────────
RUT_PARTIDO=71701800-1
NOMBRE_PARTIDO=Partido Comunista de Chile

# ─── SII (descarga de DTE / BHE / F29) ────────────────────────
# SECRETO: la clave tributaria NUNCA debe commitearse. Solo en .env.
SII_RUT=71701800-1
SII_CLAVE_TRIBUTARIA=                 # dejar vacío aquí; completar en el .env real

# ─── Defontana (ERP — opcional) ───────────────────────────────
DEFONTANA_BASE_URL=https://api.defontana.com/api/
DEFONTANA_COMPANY_TOKEN=             # secreto; completar en el .env real
DEFONTANA_USER_TOKEN=                # secreto; completar en el .env real
DEFONTANA_TIMEOUT=30
